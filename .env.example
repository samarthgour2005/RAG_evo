# Copy to .env next to docker-compose.yml and fill in. .env is git-ignored and
# docker-ignored, so the key never lands in a commit or in the image.
#   cp .env.example .env && chmod 600 .env

# Required for answer generation. Free key: https://console.groq.com/keys
# Without it retrieval still works, and /health/deep reports the missing key.
GROQ_API_KEY=

# The Vercel origin(s) allowed to call this API. Comma-separated, no trailing
# slash. Never '*' on a deployment that spends Groq budget.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Public hostname Caddy gets a Let's Encrypt certificate for. Its DNS A record
# must point at this machine, and ports 80 and 443 must be open.
API_DOMAIN=your-subdomain.duckdns.org

# Optional — defaults shown.
# LLM_MODEL=openai/gpt-oss-20b
# RATE_LIMIT_PER_SECOND=1
# RATE_LIMIT_BURST=10
# BENCHMARK_BUDGET_SECONDS=20
# 1 on hosts whose disk does not survive a restart (e.g. a free HF Space).
# STORAGE_EPHEMERAL=0
# Set to use a durable Redis indexing queue instead of the in-process thread.
# REDIS_URL=redis://localhost:6379/0
